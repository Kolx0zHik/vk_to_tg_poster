# Секреты проекта. Скопируйте в data/.env рядом с config.yaml (или туда, куда смотрит CONFIG_PATH).
# Здесь лежат ТОЛЬКО секреты; все настройки — в config.yaml и веб-панели.
# Переменные уже заданные в окружении контейнера имеют приоритет над этим файлом.

# VK API token (служебный токен сообщества)
VK_API_TOKEN=

# Telegram bot token
TELEGRAM_BOT_TOKEN=

# Ключ OpenAI-совместимого API для семантической проверки дублей (OpenRouter и т.п.)
LLM_API_KEY=
